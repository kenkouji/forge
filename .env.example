# RemoteForge Environment Configuration Template
# Copy this file to .env and configure for your environment.
# NEVER commit the actual .env file.

# Server Network Configuration (Server-Agnostic: listens on 0.0.0.0)
SERVER_HOST=0.0.0.0
SERVER_PORT=8000
SERVER_PUBLIC_URL=http://localhost:8000

# Database Configuration (SQLite for local dev, migrate to postgresql:// on home server)
DATABASE_URL=sqlite:///./remoteforge.db

# Authentication Secrets
JWT_SECRET=change-this-to-a-super-secret-random-32-char-key-in-production
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Default Admin User Credentials (Initialized on first boot)
INITIAL_ADMIN_USERNAME=admin
INITIAL_ADMIN_PASSWORD=remoteforge_secure_pass

# PC Agent Authentication Secret Token
AGENT_TOKEN=rf_agent_secret_token_default_replace_me

# NetBird VPN / Network Information (Informational & CORS setup)
NETBIRD_SERVER_ADDRESS=
CORS_ORIGINS=["http://localhost:5173","http://localhost:8000","http://127.0.0.1:5173","http://127.0.0.1:8000"]

# Optional AI Engine Configuration (Phase 4)
AI_PROVIDER=
AI_API_KEY=
